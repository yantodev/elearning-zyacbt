# Salin file ini menjadi .env sebelum menjalankan Docker Compose.
DB_DATABASE=zyacbt
DB_USERNAME=zyacbt
DB_PASSWORD=ganti-dengan-password-kuat
DB_ROOT_PASSWORD=ganti-dengan-password-root-kuat
ENCRYPTION_KEY=ganti-dengan-kunci-enkripsi-minimal-32-karakter
CSRF_PROTECTION=1
APP_IMAGE=ghcr.io/yantodev/elearning-zyacbt:latest
